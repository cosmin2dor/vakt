# Copy to .env and adjust for your machine. docker-compose.yml falls back
# to these defaults on its own, so .env is optional for a quick start.

# Host path bind-mounted into the container at /vault. Must exist before
# `make up` (create it with `mkdir -p` if you're starting fresh).
VAULT_PATH=./vault

# Host port the container's :8080 is published on.
VAKT_PORT=8080

# Timezone the daemon uses for cron evaluation (SDD.md §3, G9).
TZ=UTC
